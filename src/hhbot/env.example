# --- hh.ru OAuth (создать приложение: https://dev.hh.ru/admin) ---
HH_CLIENT_ID=
HH_CLIENT_SECRET=
HH_REDIRECT_URI=http://localhost:8765/callback
# Обязательное требование hh.ru: имя приложения и контактный email
HH_USER_AGENT=hhbot/0.1 (your@email.com)

# --- Anthropic (генерация писем и ответов в чате) ---
ANTHROPIC_API_KEY=
